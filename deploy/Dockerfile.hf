# Imagem da API para o Hugging Face Spaces.
#
# Diferenças para o Dockerfile da raiz, e o motivo de cada uma:
#
#   porta 7860   é a que o Spaces expõe; qualquer outra não recebe tráfego.
#   usuário 1000 o Spaces roda como usuário não-root com esse uid. Instalar como
#                root e servir como 1000 quebra o cache do HOME.
#   sem `[local]` o extra arrasta torch (526MB) e transformers (113MB). Em produção o
#                embedding é remoto e o reranker está desligado por medição
#                (EVALUATION.md 4.4), então nada aqui usa os dois.
#   sem samples/ o corpus vive no Qdrant Cloud, já indexado. A imagem não carrega
#                material nenhum.
#
# Build local, para conferir antes de subir:
#   docker build -f deploy/Dockerfile.hf -t grifo-api .
#   docker run --rm -p 7860:7860 --env-file .env grifo-api

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

RUN useradd -m -u 1000 user
USER user
WORKDIR /home/user/app

COPY --chown=user pyproject.toml README.md ./
COPY --chown=user src/ ./src/
RUN pip install --user --upgrade pip && pip install --user -e .

EXPOSE 7860

# `--proxy-headers` porque o Spaces termina TLS num proxy à frente: sem isso a
# aplicação enxerga http e monta URL errada em qualquer redirect.
CMD ["uvicorn", "grifo.api.main:app", "--host", "0.0.0.0", "--port", "7860", "--proxy-headers"]
